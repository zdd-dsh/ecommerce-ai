<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.ecommerce.mapper.UserMapper">
<!--    结果映射 数据库中表中的列名对应java实体类中的属性名
        id =""自定义 使用resultMap的标识
        colum="" 写的是数据库中的列名
        property=“” 写的是java实体类的属性名-->
    <resultMap id="BaseResultMap" type="com.example.ecommerce.entity.User">
        <id column="id" property="id"></id>
        <result column="username" property="username"></result>
        <result column="password" property="password"></result>
        <result column="nickname" property="nickname"></result>
        <result column="email" property="email"></result>
        <result column="phone" property="phone"></result>
        <result column="role" property="role"></result>
        <result column="status" property="status"></result>
        <result column="create_time" property="createTime"></result>
        <result column="update_time" property="updateTime"></result>
    </resultMap>

<!--    定义一个可重复用列名列表
        id=""自定义，是使用sql的标识
    -->
    <sql id="Base_Column_List">
        id, username, password, nickname, email, phone, role, status, create_time, update_time
    </sql>

    <!-- 配置UserMapper接口中的 User selectById(Long id)方法
         id="" 的值写的是接口中要配置的方法名
         resultMap=""使用配置好的resultMap，根据id来使用
    -->
    <select id="selectById" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"></include> from user where id=#{id}
    </select>
<!--    配置userMapper接口中第二个方法 selectByUsername-->
    <select id="selectByUsername" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"></include> from user where username=#{username}
    </select>
<!--    配置userMapper方法中的selectAll方法-->
    <select id="selectAll" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"></include> from user
    </select>
<!--    配置userMapper中long selectAll()-->
    <select id="countAll" resultType="long">
        select count(*) from user
    </select>
<!--    配置userMapper接口中的int insert方法-->
    <insert id="insert" parameterType="com.example.ecommerce.entity.User" useGeneratedKeys="true" keyProperty="id">
        insert into user(username,password,nickname,email,phone,role,status)
        values(#{username},#{password},#{nickname},#{email},#{phone},#{role},#{status})

    </insert>
    <!-- 配置UserMapper接口中的 int update(User user) 方法 -->
    <update id="update" parameterType="com.example.ecommerce.entity.User">
        update user
        set username = #{username}, password = #{password}, nickname = #{nickname}, email = #{email}, phone = #{phone}, role = #{role}, status = #{status}, update_time = now()
        where id = #{id}
    </update>
    <!--配置UserMapper接口中的 int updatePassword(@Param("id") Long id, @Param("password") String password) 方法
目的：单独更新密码
-->
    <update id="updatePassword">
        update user set password = #{password}, update_time = now()
        where id = #{id}
    </update>
    <!-- 配置UserMapper接口中的 int delete(Long id) 方法 -->
    <delete id="delete" parameterType="java.lang.Long">
        delete from user where id = #{id}
    </delete>

    <update id="updateNickname">
        UPDATE `user`
        SET nickname = #{nickname},
            update_time = now()
        WHERE id = #{id}
    </update>

    <update id="updateEmail">
        UPDATE `user`
        SET email = #{email}, update_time = now()
        WHERE id = #{id}
    </update>

    <update id="updatePhone">
        UPDATE `user`
        SET phone = #{phone}, update_time = now()
        WHERE id = #{id}
    </update>
    <select id="selectByPhone" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"></include> from user where phone = #{phone}
    </select>
</mapper>
